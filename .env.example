# =============================================================================
# AI Receptionist SaaS - Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -------------------------
# Database (PostgreSQL)
# -------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/ai_receptionist"

# -------------------------
# NextAuth / Auth
# -------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-32-char-minimum-string"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------
# App
# -------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -------------------------
# AI Providers (at least one required)
# -------------------------
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.0-flash"

# -------------------------
# Speech (optional)
# -------------------------
DEEPGRAM_API_KEY=""          # For speech-to-text
ELEVENLABS_API_KEY=""        # For text-to-speech custom voices

# -------------------------
# Telephony - Twilio
# -------------------------
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+15551234567"
TWILIO_WHATSAPP_NUMBER="+15551234567"   # optional
# Strict webhook signature verification:
# - defaults to true in production, false in non-production
TWILIO_WEBHOOK_STRICT_VALIDATION="false"

# -------------------------
# Billing - Creem.io
# Sign up at https://creem.io
# -------------------------
CREEM_API_KEY="creem_..."
CREEM_WEBHOOK_SECRET="whsec_..."
# Use test API in dev, production in prod:
CREEM_API_URL="https://test-api.creem.io/v1"
# CREEM_API_URL="https://api.creem.io/v1"

# Product IDs from your Creem dashboard:
CREEM_PRODUCT_STARTER="prod_..."
CREEM_PRODUCT_GROWTH="prod_..."
CREEM_PRODUCT_PRO="prod_..."
CREEM_PRODUCT_ENTERPRISE="prod_..."

# -------------------------
# Email - Resend
# Sign up at https://resend.com
# -------------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="AI Receptionist <notifications@yourdomain.com>"

# -------------------------
# Vector DB - Pinecone (for Knowledge Base)
# -------------------------
PINECONE_API_KEY=""
PINECONE_INDEX="ai-receptionist"

# -------------------------
# Redis (optional - for rate limiting & queues)
# -------------------------
REDIS_URL="redis://localhost:6379"

# -------------------------
# Google Calendar Integration (optional)
# -------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# -------------------------
# HubSpot CRM (optional)
# -------------------------
HUBSPOT_API_KEY=""

# -------------------------
# Sentry (optional - error monitoring)
# -------------------------
SENTRY_DSN=""

# -------------------------
# Feature Flags
# -------------------------
ENABLE_SMS="true"
ENABLE_WHATSAPP="false"
# Optional analytics assumption for revenue tracking:
AVERAGE_APPOINTMENT_VALUE="200"

# -------------------------
# Security
# -------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# -------------------------
# Internal
# -------------------------
HOST_PROVISION_SECRET="your-provision-secret"
