generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                            String                  @id @default(cuid())
  name                          String
  slug                          String                  @unique
  domain                        String?                 @unique
  website                       String?
  description                   String?
  logoUrl                       String?
  industry                      String?
  timezone                      String                  @default("America/New_York")
  defaultLanguage               String                  @default("en")
  status                        TenantStatus            @default(ACTIVE)
  billingCustomerId             String?                 @unique @map("stripeCustomerId")
  billingSubscriptionId         String?                 @unique @map("stripeSubscriptionId")
  plan                          PlanTier                @default(STARTER)
  monthlyMinutes                Int                     @default(100)
  maxReceptionists              Int                     @default(1)
  maxPhoneNumbers               Int                     @default(1)
  maxKnowledgeSources           Int                     @default(5)
  trialEndsAt                   DateTime?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  googleCalendarId              String?
  defaultMeetingDurationMinutes Int                     @default(30)
  meetingBufferMinutes          Int                     @default(0)
  slotStepMinutes               Int                     @default(15)
  defaultAppointmentValue       Float                   @default(200)
  pricingCatalog                Json?
  revenueCurrency               String                  @default("USD")
  aiReceptionists               AIReceptionist[]
  appointments                  Appointment[]
  auditLogs                     AuditLog[]
  availabilityExceptions        AvailabilityException[]
  blocklist                     Blocklist[]
  businessHours                 BusinessHour[]
  calls                         Call[]
  callEvents                    CallEvent[]
  contacts                      Contact[]
  conversations                 Conversation[]
  conversationMessages          ConversationMessage[]
  directories                   DirectoryEntry[]
  embeddings                    Embedding[]
  integrations                  Integration[]
  invoices                      Invoice[]
  knowledgeSources              KnowledgeSource[]
  leads                         Lead[]
  phoneNumbers                  PhoneNumber[]
  messages                      SMSMessage[]
  scheduledCalls                ScheduledCall[]
  subscriptions                 Subscription[]
  transcripts                   Transcript[]
  transfers                     Transfer[]
  transferRules                 TransferRule[]
  usageRecords                  UsageRecord[]
  users                         User[]

  @@index([billingCustomerId])
  @@index([slug])
  @@index([status])
}

model User {
  id                      String                   @id @default(cuid())
  tenantId                String
  email                   String
  name                    String
  passwordHash            String
  role                    UserRole                 @default(MEMBER)
  avatar                  String?
  phone                   String?
  status                  UserStatus               @default(ACTIVE)
  emailVerified           Boolean                  @default(false)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  resetToken              String?
  resetTokenExpires       DateTime?
  appointments            Appointment[]            @relation("StaffAppointments")
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([resetToken])
}

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String
  externalSubscriptionId String             @unique @map("stripeSubscriptionId")
  externalProductId      String             @map("stripePriceId")
  status                 SubscriptionStatus @default(ACTIVE)
  plan                   PlanTier
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([externalSubscriptionId])
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  externalInvoiceId String        @unique @map("stripeInvoiceId")
  amountDue         Int
  amountPaid        Int           @default(0)
  currency          String        @default("usd")
  status            InvoiceStatus @default(DRAFT)
  periodStart       DateTime
  periodEnd         DateTime
  pdfUrl            String?
  hostedUrl         String?
  baseAmount        Int           @default(0)
  usageAmount       Int           @default(0)
  minutesUsed       Int           @default(0)
  overageMinutes    Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([externalInvoiceId])
}

model AIReceptionist {
  id                       String             @id @default(cuid())
  tenantId                 String
  name                     String
  description              String?
  status                   ReceptionistStatus @default(DRAFT)
  voiceProvider            String             @default("openai")
  voiceId                  String             @default("alloy")
  voiceSpeed               Float              @default(1.0)
  voiceLanguage            String             @default("en")
  llmProvider              String             @default("openai")
  llmModel                 String             @default("gpt-4o-mini")
  temperature              Float              @default(0.7)
  maxTokens                Int                @default(1024)
  sttProvider              String             @default("deepgram")
  greeting                 String             @default("Hello! Thank you for calling. How can I help you today?")
  systemPrompt             String?
  fallbackMessage          String             @default("I apologize, I'm having trouble understanding. Let me transfer you to someone who can help.")
  enableInterruptions      Boolean            @default(true)
  enableSmsFollowup        Boolean            @default(true)
  enableVoicemail          Boolean            @default(true)
  enableEmergencyDetect    Boolean            @default(true)
  neverSendToVoicemail     Boolean            @default(false)
  maxCallDuration          Int                @default(600)
  silenceTimeout           Int                @default(10)
  operatingMode            String             @default("standard")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  enableMissedCallFollowup Boolean            @default(false)
  missedCallFollowupDelay  Int                @default(600)
  smsSummaryTemplate       String?
  vapiAssistantId          String?
  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls                    Call[]
  knowledgeSources         KnowledgeSource[]
  phoneNumbers             PhoneNumber[]

  @@index([tenantId])
  @@index([status])
}

model PhoneNumber {
  id                String            @id @default(cuid())
  tenantId          String
  receptionistId    String?
  number            String            @unique
  provider          String            @default("twilio")
  providerSid       String?
  friendlyName      String?
  capabilities      String            @default("voice,sms")
  status            PhoneNumberStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customGreeting    String?
  dndBypass         Boolean           @default(false)
  isVip             Boolean           @default(false)
  vapiPhoneNumberId String?
  calls             Call[]
  receptionist      AIReceptionist?   @relation(fields: [receptionistId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  smsMessages       SMSMessage[]
  scheduledCalls    ScheduledCall[]

  @@index([tenantId])
  @@index([number])
}

model KnowledgeSource {
  id             String                @id @default(cuid())
  tenantId       String
  receptionistId String?
  type           KnowledgeSourceType
  name           String
  content        String?
  url            String?
  fileUrl        String?
  status         KnowledgeSourceStatus @default(PENDING)
  metadata       Json?
  chunkCount     Int                   @default(0)
  lastSyncedAt   DateTime?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  embeddings     Embedding[]
  receptionist   AIReceptionist?       @relation(fields: [receptionistId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([receptionistId])
  @@index([status])
}

model Embedding {
  id                String          @id @default(cuid())
  tenantId          String
  knowledgeSourceId String
  content           String
  embedding         String?
  vectorId          String?
  metadata          Json?
  chunkIndex        Int             @default(0)
  createdAt         DateTime        @default(now())
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeSourceId])
  @@index([vectorId])
}

model Call {
  id              String          @id @default(cuid())
  tenantId        String
  receptionistId  String?
  phoneNumberId   String?
  contactId       String?
  providerCallSid String?         @unique
  callerNumber    String
  dialedNumber    String
  direction       CallDirection
  status          CallStatus      @default(RINGING)
  duration        Int?
  recordingUrl    String?
  recordingSid    String?
  costCents       Int?
  summary         String?
  sentiment       Sentiment?
  intent          String?
  resolved        Boolean         @default(false)
  escalated       Boolean         @default(false)
  startedAt       DateTime        @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contact         Contact?        @relation(fields: [contactId], references: [id])
  phoneNumber     PhoneNumber?    @relation(fields: [phoneNumberId], references: [id])
  receptionist    AIReceptionist? @relation(fields: [receptionistId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  callEvents      CallEvent[]
  lead            Lead?
  transcripts     Transcript[]
  transfers       Transfer[]

  @@index([tenantId])
  @@index([tenantId, startedAt(sort: Desc)])
  @@index([receptionistId])
  @@index([providerCallSid])
  @@index([callerNumber])
  @@index([startedAt])
  @@index([status])
}

model CallEvent {
  id        String   @id @default(cuid())
  tenantId  String
  callId    String
  type      String
  data      Json?
  latencyMs Int?
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([tenantId])
  @@index([type])
}

model Transcript {
  id         String   @id @default(cuid())
  tenantId   String
  callId     String
  speaker    Speaker
  content    String
  startMs    Int?
  endMs      Int?
  confidence Float?
  createdAt  DateTime @default(now())
  call       Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([tenantId])
}

model Transfer {
  id         String         @id @default(cuid())
  tenantId   String
  callId     String
  type       TransferType
  target     String
  targetName String?
  department String?
  reason     String?
  status     TransferStatus @default(INITIATED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  call       Call           @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([tenantId])
}

model SMSMessage {
  id            String        @id @default(cuid())
  tenantId      String
  phoneNumberId String?
  contactId     String?
  direction     CallDirection
  fromNumber    String
  toNumber      String
  body          String
  providerSid   String?
  status        String        @default("sent")
  messageType   String        @default("text")
  createdAt     DateTime      @default(now())
  contact       Contact?      @relation(fields: [contactId], references: [id])
  phoneNumber   PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([phoneNumberId])
}

model UsageRecord {
  id          String    @id @default(cuid())
  tenantId    String
  type        UsageType
  quantity    Float
  unitCost    Float     @default(0)
  totalCost   Float     @default(0)
  callId      String?
  metadata    Json?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([periodStart, periodEnd])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Contact {
  id               String          @id @default(cuid())
  tenantId         String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  company          String?
  position         String?
  source           String?
  status           String          @default("lead")
  tags             Json?
  notes            String?
  lastContactAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  hubspotContactId String?
  isVip            Boolean         @default(false)
  appointments     Appointment[]
  calls            Call[]
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  smsMessages      SMSMessage[]
  scheduledCalls   ScheduledCall[]

  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@index([tenantId, phone])
}

model Appointment {
  id              String   @id @default(cuid())
  tenantId        String
  contactId       String
  staffId         String?
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          String   @default("scheduled")
  source          String   @default("manual")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  externalEventId String?
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  staff           User?    @relation("StaffAppointments", fields: [staffId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([startTime])
}

model BusinessHour {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model AvailabilityException {
  id            String    @id @default(cuid())
  tenantId      String
  dayOfWeek     Int
  exceptionDate DateTime?
  startTime     String
  endTime       String
  label         String?
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, exceptionDate])
}

model DirectoryEntry {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  title       String?
  department  String?
  extension   String?
  phoneNumber String?
  email       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, department])
}

model TransferRule {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  triggerType  String
  triggerValue String
  targetType   String
  targetValue  String
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, triggerType])
}

model Conversation {
  id        String                @id @default(cuid())
  tenantId  String
  contactId String?
  channel   String                @default("chat")
  status    String                @default("active")
  summary   String?
  intent    String?
  sentiment String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  contact   Contact?              @relation(fields: [contactId], references: [id])
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]

  @@index([tenantId])
  @@index([contactId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  messageType    String       @default("text")
  metadata       Json?
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
}

model Integration {
  id           String    @id @default(cuid())
  tenantId     String
  provider     String
  status       String    @default("active")
  credentials  Json?
  config       Json?
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  callId    String?    @unique
  name      String?
  email     String?
  phone     String?
  intent    String?
  status    LeadStatus @default(NEW)
  source    String?    @default("voice")
  details   Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  call      Call?      @relation(fields: [callId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([phone])
}

model Blocklist {
  id        String   @id @default(cuid())
  tenantId  String
  number    String
  reason    String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
}

model ScheduledCall {
  id            String              @id @default(cuid())
  tenantId      String
  contactId     String?
  phoneNumberId String?
  scheduledTime DateTime
  type          ScheduledCallType
  status        ScheduledCallStatus @default(PENDING)
  metadata      Json?
  retryCount    Int                 @default(0)
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  contact       Contact?            @relation(fields: [contactId], references: [id])
  phoneNumber   PhoneNumber?        @relation(fields: [phoneNumberId], references: [id])
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([scheduledTime])
  @@index([status])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  INCOMPLETE
  PAUSED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum ReceptionistStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PhoneNumberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum KnowledgeSourceType {
  WEBSITE
  PDF
  FAQ
  TEXT
  CRAWL
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  VOICEMAIL
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Speaker {
  CALLER
  AI
  SYSTEM
}

enum TransferType {
  BLIND
  WARM
  VOICEMAIL
  DEPARTMENT
  EXTENSION
}

enum TransferStatus {
  INITIATED
  RINGING
  CONNECTED
  FAILED
  NO_ANSWER
}

enum UsageType {
  VOICE_MINUTES
  SMS_SENT
  SMS_RECEIVED
  STT_MINUTES
  TTS_CHARACTERS
  LLM_TOKENS
  KNOWLEDGE_EMBEDDINGS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum ScheduledCallType {
  CALLBACK
  FOLLOW_UP
  REMINDER
  SMS_SUMMARY
}

enum ScheduledCallStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}
