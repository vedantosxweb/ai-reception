{
  "name": "ai-receptionist-saas",
  "version": "1.0.0",
  "description": "Production-grade AI Receptionist SaaS platform with multi-tenant architecture",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "prisma generate && NODE_ENV=production next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "start:prod": "NODE_ENV=production PORT=${PORT:-3000} node .next/standalone/server.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "ci:check": "npm run prisma:validate && npm run typecheck && npm run build",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "integrations:backfill-encryption": "node scripts/backfill-integration-credentials.js",
    "launch:check": "node scripts/launch-readiness-check.js",
    "launch:check:skip-llm": "node scripts/launch-readiness-check.js --skip-llm",
    "launch:uat": "node scripts/launch-uat-check.js",
    "launch:uat:skip-llm": "node scripts/launch-uat-check.js --skip-llm",
    "health": "curl -s http://localhost:${PORT:-3000}/api/v1/health | node -e 'process.stdin.resume();let d=\"\";process.stdin.on(\"data\",c=>d+=c);process.stdin.on(\"end\",()=>{const j=JSON.parse(d);console.log(j.data.status===\"healthy\"?\"✓ Healthy\":\"✗ Unhealthy\");process.exit(j.data.status===\"healthy\"?0:1)})'"
  },
